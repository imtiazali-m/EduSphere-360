import { useEffect, useMemo, useState } from 'react'
import { Activity, ArrowDownRight, ArrowRight, Bell, BookOpen, CalendarCheck, CalendarDays, ChevronDown, ClipboardCheck, Command, FileText, GraduationCap, LayoutDashboard, LogOut, Menu, Megaphone, ShieldCheck, Users, Wallet, X } from 'lucide-react'
import { useAuth } from '../context/AuthContext'
import { modulesForRole, roleLabels } from '../lib/modules'
import { listRecords } from '../lib/data'
import type { ModuleConfig } from '../lib/types'
import { RecordModule } from './RecordModule'
import { AccountsModule } from './AccountsModule'
import { FilesModule } from './FilesModule'

interface Props {onToast:(message:string,error?:boolean)=>void}
const icons:Record<string,typeof LayoutDashboard>={LayoutDashboard,GraduationCap,Users,CalendarCheck,ClipboardCheck,Wallet,BookOpen,CalendarDays,Megaphone,FileText}
const moduleIcon:Record<string,string>={students:'GraduationCap',teachers:'Users',attendance:'CalendarCheck',exams:'ClipboardCheck',exam_results:'ClipboardCheck',fees:'Wallet',assignments:'BookOpen',timetable:'CalendarDays',announcements:'Megaphone'}

function Overview({onNavigate,onToast}: {onNavigate:(key:string)=>void;onToast:(message:string,error?:boolean)=>void}) {
  const {user,mode}=useAuth();const [stats,setStats]=useState({students:0,teachers:0,attendance:0,fees:0,assignments:0,exams:0});const [loading,setLoading]=useState(true)
  useEffect(()=>{let live=true;async function load(){try{const [s,t,a,f,w,e]=await Promise.all(['students','teachers','attendance','fee_invoices','assignments','exams'].map(table=>listRecords(mode,user!,table).catch(()=>[])));if(live)setStats({students:s.length,teachers:t.length,attendance:a.length,fees:f.length,assignments:w.length,exams:e.length})}catch(err){if(live)onToast(err instanceof Error?err.message:'Could not load overview.',true)}finally{if(live)setLoading(false)}}void load();return()=>{live=false}},[mode,user?.id])
  const cards=[{label:'Students',value:stats.students,sub:'Learner profiles',icon:GraduationCap,color:'blue',page:'students'},{label:'Faculty members',value:stats.teachers,sub:'Teacher and staff records',icon:Users,color:'violet',page:'teachers'},{label:'Attendance entries',value:stats.attendance,sub:'Recorded sessions',icon:CalendarCheck,color:'green',page:'attendance'},{label:'Fee invoices',value:stats.fees,sub:'Student fee accounts',icon:Wallet,color:'amber',page:'fees'}]
  return <div className="page-content"><div className="page-title-row"><div><div className="eyebrow">INSTITUTION OVERVIEW</div><h1>Good day, {user?.fullName.split(' ')[0]}.</h1><p>Here is what is happening at {user?.institutionName}.</p></div><span className="date-chip">{new Date().toLocaleDateString(undefined,{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</span></div><div className="metric-grid">{cards.map(card=><button className="metric-card" key={card.label} onClick={()=>onNavigate(card.page)}><div className={`metric-icon ${card.color}`}><card.icon size={20}/></div><span className="metric-label">{card.label}</span><strong>{loading?'—':card.value.toLocaleString()}</strong><small>{card.sub}</small><ArrowDownRight className="metric-arrow" size={17}/></button>)}</div><div className="overview-grid"><section className="table-card overview-panel"><div className="panel-heading"><div><h3>Academic workspace</h3><p>Open a module to manage its records.</p></div><span className="panel-tag">{mode==='local'?'LOCAL':'CLOUD'}</span></div><div className="quick-module-grid">{[{key:'exams',label:'Examinations',icon:ClipboardCheck},{key:'exam_results',label:'Exam results',icon:ClipboardCheck},{key:'assignments',label:'Assignments',icon:BookOpen},{key:'timetable',label:'Timetable',icon:CalendarDays},{key:'announcements',label:'Announcements',icon:Megaphone}].map(item=><button key={item.key} className="quick-module" onClick={()=>onNavigate(item.key)}><div><item.icon size={19}/></div><span>{item.label}</span><ArrowRight size={15}/></button>)}</div></section><section className="table-card overview-panel"><div className="panel-heading"><div><h3>Platform connections</h3><p>Your workspace environment.</p></div><Activity size={18} className="muted-icon"/></div><div className="connection-list"><div><span className="connection-indicator green"/><span><strong>{mode==='local'?'Local browser database':'Supabase cloud database'}</strong><small>{mode==='local'?'Offline records stored on this device':'Institution records protected by RLS'}</small></span><span className="connection-state">Active</span></div><div><span className="connection-indicator blue"/><span><strong>Role-based workspace</strong><small>{roleLabels[user!.role]}</small></span><span className="connection-state">Active</span></div><div><span className="connection-indicator amber"/><span><strong>Files & documents</strong><small>{mode==='local'?'Private files stored in this browser':'Private institution storage'}</small></span><span className="connection-state">{mode==='local'?'Offline':'Ready'}</span></div></div></section></div><div className="bottom-note"><ShieldCheck size={18}/><span><strong>Keep student information private.</strong> Only create accounts for people who belong to this institution. Online mode enforces access using database policies; offline mode stores data in this browser.</span></div></div>
}

export function Dashboard({onToast}:Props) {
  const {user,mode,signOut}=useAuth();const [active,setActive]=useState('overview');const [sidebarOpen,setSidebarOpen]=useState(false);const [profileOpen,setProfileOpen]=useState(false)
  const available=useMemo(()=>modulesForRole(user!.role),[user?.role])
  const activeModule=available.find(m=>m.key===active)
  const nav=[{key:'overview',label:'Overview',icon:LayoutDashboard},...available.map(m=>({key:m.key,label:m.title,icon:icons[moduleIcon[m.key]]??FileText})),...(user && ['owner','admin'].includes(user.role)?[{key:'accounts',label:'User accounts',icon:Users},{key:'files',label:'Files & documents',icon:FileText}]:[])]
  function navigate(key:string){setActive(key);setSidebarOpen(false)}
  async function logout(){await signOut();setProfileOpen(false)}
  return <div className="app-shell"><aside className={`sidebar ${sidebarOpen?'sidebar-open':''}`}><div className="sidebar-brand"><div className="brand-mark"><GraduationCap size={22}/></div><div><strong>EduSphere <span>360</span></strong><small>EDUCATION MANAGEMENT</small></div><button className="mobile-close icon-button" onClick={()=>setSidebarOpen(false)}><X size={18}/></button></div><div className="institution-switch"><div className="institution-avatar"><GraduationCap size={18}/></div><div><strong>{user?.institutionName}</strong><small>{user?.role==='owner'?'Institution owner':'Institution workspace'}</small></div><ChevronDown size={15}/></div><div className="sidebar-label">WORKSPACE</div><nav className="sidebar-nav">{nav.map(item=><button key={item.key} className={active===item.key?'active':''} onClick={()=>navigate(item.key)}><item.icon size={18}/><span>{item.label}</span>{active===item.key&&<i/>}</button>)}</nav><div className="sidebar-bottom"><div className="sidebar-help"><div className="help-icon"><Command size={17}/></div><div><strong>EduSphere 360</strong><small>{mode==='local'?'Offline workspace':'Cloud-connected'}</small></div></div><button className="sidebar-nav-button" onClick={()=>navigate('announcements')}><Bell size={17}/> <span>Notifications</span></button><button className="sidebar-nav-button" onClick={()=>void logout()}><LogOut size={17}/> <span>Sign out</span></button></div></aside>{sidebarOpen&&<div className="sidebar-scrim" onClick={()=>setSidebarOpen(false)}/>}<main className="main-shell"><header className="app-topbar"><button className="mobile-menu icon-button" onClick={()=>setSidebarOpen(true)}><Menu size={20}/></button><div className="breadcrumbs"><span>EduSphere 360</span><span>/</span><strong>{active==='overview'?'Overview':active==='accounts'?'User accounts':active==='files'?'Files & documents':activeModule?.title??'Workspace'}</strong></div><div className="topbar-right"><span className={`workspace-mode ${mode}`}><i/>{mode==='local'?'Offline mode':'Cloud mode'}</span><button className="topbar-icon icon-button" onClick={()=>navigate('announcements')} title="Announcements"><Bell size={18}/></button><div className="profile-wrap"><button className="profile-button" onClick={()=>setProfileOpen(!profileOpen)}><span className="user-avatar">{user?.fullName.slice(0,1).toUpperCase()}</span><span className="profile-meta"><strong>{user?.fullName}</strong><small>{roleLabels[user!.role]}</small></span><ChevronDown size={15}/></button>{profileOpen&&<div className="profile-menu"><div><strong>{user?.email}</strong><small>{user?.institutionName}</small></div><button onClick={()=>void logout()}><LogOut size={15}/> Sign out</button></div>}</div></div></header>{active==='overview'?<Overview onNavigate={navigate} onToast={onToast}/>:active==='accounts'?<AccountsModule onToast={onToast}/>:active==='files'?<FilesModule onToast={onToast}/>:activeModule?<RecordModule module={activeModule as ModuleConfig} onToast={onToast}/>:<Overview onNavigate={navigate} onToast={onToast}/>}</main></div>
}
