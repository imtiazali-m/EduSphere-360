@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{font-family:'DM Sans',Inter,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#17283e;background:#f4f7fb;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;--navy:#102d4d;--blue:#2f6fe4;--blue-dark:#245bc0;--muted:#718096;--line:#e7edf4;--surface:#fff;--bg:#f4f7fb;--green:#1b9a70;--shadow:0 12px 36px rgba(27,55,89,.07)}*{box-sizing:border-box}body{margin:0;min-width:320px;min-height:100vh}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{opacity:.55;cursor:not-allowed}a{color:inherit}.welcome-shell,.auth-shell{min-height:100vh;background:#f8faff}.public-nav{height:76px;padding:0 clamp(22px,6vw,96px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #edf1f7;background:rgba(255,255,255,.88)}.brand-lockup,.sidebar-brand{display:flex;align-items:center;gap:11px}.brand-mark{width:42px;height:42px;border-radius:13px;background:linear-gradient(145deg,#3978ee,#214c9e);color:#fff;display:grid;place-items:center;box-shadow:0 7px 14px rgba(47,111,228,.22)}.brand-lockup strong,.sidebar-brand strong{font:800 16px Manrope,sans-serif;letter-spacing:-.5px;color:#153353}.brand-lockup strong span,.sidebar-brand strong span{color:#3d7bec}.brand-lockup small,.sidebar-brand small{display:block;font-size:8px;font-weight:700;letter-spacing:1.4px;color:#8795a7;margin-top:2px}.nav-right{display:flex;align-items:center;gap:17px}.connection-pill,.workspace-mode{display:inline-flex;align-items:center;gap:7px;border-radius:30px;padding:7px 11px;font-size:11px;font-weight:700}.connection-pill.local,.workspace-mode.local{color:#a46d12;background:#fff6df}.connection-pill.cloud,.workspace-mode.cloud{color:#168765;background:#e9f8f1}.button{border:0;border-radius:10px;padding:11px 16px;display:inline-flex;align-items:center;justify-content:center;gap:9px;font-size:13px;font-weight:700;transition:.18s ease}.button-primary{color:#fff;background:linear-gradient(135deg,#3478ef,#2862ce);box-shadow:0 7px 16px rgba(47,111,228,.2)}.button-primary:hover{background:linear-gradient(135deg,#286ce0,#1f54b9);transform:translateY(-1px)}.button-outline{border:1px solid #dce5f0;background:#fff;color:#28415e}.button-outline:hover,.button-quiet:hover{background:#f0f5fc}.button-quiet{background:transparent;color:#405771}.button-small{padding:9px 13px}.button-large{padding:14px 19px;font-size:13px}.button-full{width:100%;margin-top:4px}.hero-section{max-width:1250px;margin:0 auto;padding:88px 28px 77px;display:grid;grid-template-columns:1.03fr 1fr;align-items:center;gap:60px}.eyebrow{font-size:10px;letter-spacing:1.65px;font-weight:800;color:#557397;display:flex;align-items:center;gap:9px}.eyebrow-dot{width:7px;height:7px;background:#3478ef;border-radius:50%;box-shadow:0 0 0 4px #e6efff}.hero-copy h1,.auth-side-copy h1,.setup-intro h1{font:800 clamp(40px,5vw,62px)/1.13 Manrope,sans-serif;letter-spacing:-2.5px;color:#102c4b;margin:19px 0 17px}.hero-copy h1 span,.auth-side-copy h1 span,.setup-intro h1 span{color:#3876e8}.hero-lead,.auth-side-copy>p,.setup-intro>p{font-size:15px;line-height:1.8;color:#6a7d94;max-width:560px;margin:0}.hero-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:29px}.hero-notes{display:flex;gap:20px;flex-wrap:wrap;margin-top:28px;color:#6c7f96;font-size:11px;font-weight:600}.hero-notes span{display:flex;align-items:center;gap:7px}.hero-notes svg{color:#3a78e9}.hero-visual{position:relative;padding:20px 0 20px 20px}.visual-glow{position:absolute;inset:5% -4% 0 5%;background:radial-gradient(ellipse at center,#dbe8ff 0%,rgba(219,232,255,0) 70%);filter:blur(14px)}.visual-window{position:relative;z-index:1;background:white;border:1px solid #e5ebf4;border-radius:17px;padding:19px;box-shadow:0 25px 65px rgba(32,67,112,.15);transform:perspective(1100px) rotateY(-4deg) rotateX(1deg)}.visual-top{display:flex;align-items:center;gap:12px;color:#92a1b3;font-size:8px;font-weight:800;letter-spacing:1px;padding-bottom:15px;border-bottom:1px solid #edf1f7}.window-dots{display:flex;gap:4px}.window-dots i{width:6px;height:6px;border-radius:50%;background:#c7d1de}.live-chip{margin-left:auto;color:#1b9a70;background:#e7f8f1;border-radius:20px;padding:5px 8px;font-size:7px}.visual-title{display:flex;align-items:center;justify-content:space-between;padding:21px 2px}.visual-title small{display:block;font-size:8px;letter-spacing:1px;color:#8c9aab;font-weight:800}.visual-title strong{display:block;font:700 17px Manrope;color:#183552;margin-top:5px}.visual-avatar{width:34px;height:34px;border-radius:10px;background:#eaf1ff;color:#346fd9;display:grid;place-items:center;font-size:10px;font-weight:800}.visual-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.visual-stats>div{background:#f7f9fc;border:1px solid #eef2f7;border-radius:10px;padding:13px}.visual-stats span{display:block;font-size:7px;letter-spacing:.8px;font-weight:800;color:#8998aa}.visual-stats strong{display:block;font:800 24px Manrope;color:#173a5d;margin:5px 0 3px}.visual-stats small{font-size:8px;color:#91a0b2}.visual-lower{display:grid;grid-template-columns:1.1fr .9fr;gap:12px;margin-top:12px}.visual-chart,.visual-activity{border:1px solid #edf1f6;border-radius:10px;padding:12px}.lower-label{font-size:9px;font-weight:800;color:#49617d}.lower-label small{float:right;font-size:7px;color:#9baabc;letter-spacing:.7px}.bars{height:86px;display:flex;align-items:end;gap:8px;padding:9px 5px 0}.bars i{flex:1;background:linear-gradient(180deg,#72a5ff,#3775e9);border-radius:4px 4px 1px 1px}.bar-days{display:flex;justify-content:space-around;font-size:7px;color:#9baabc;padding-top:6px}.visual-activity p{display:flex;align-items:center;gap:6px;font-size:8px;color:#62768c;margin:12px 0}.visual-activity p small{margin-left:auto;color:#a0adbc;font-size:7px}.activity-dot{width:6px;height:6px;border-radius:50%}.activity-dot.blue{background:#4a83ed}.activity-dot.green{background:#26a77d}.activity-dot.amber{background:#e1a43d}.floating-note{position:absolute;z-index:2;bottom:0;left:-2px;display:flex;align-items:center;gap:10px;background:white;border:1px solid #e8edf5;border-radius:12px;padding:11px 15px;box-shadow:0 13px 28px rgba(31,64,105,.12)}.floating-icon{width:33px;height:33px;border-radius:10px;background:#eef4ff;color:#3976e4;display:grid;place-items:center}.floating-note strong,.floating-note small{display:block}.floating-note strong{font-size:10px;color:#29415d}.floating-note small{font-size:8px;color:#8b9aad;margin-top:3px}.portal-section{background:#fff;border-top:1px solid #edf1f7;padding:53px max(28px,calc((100vw - 1194px)/2)) 63px}.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:21px}.section-heading h2{font:800 25px Manrope;letter-spacing:-.8px;color:#173451;margin:8px 0 0}.section-heading>p{max-width:340px;color:#8090a3;font-size:12px;line-height:1.6;margin:0}.portal-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.portal-card{padding:17px 14px;border:1px solid #e8edf4;border-radius:12px;background:#fff;display:flex;align-items:center;gap:11px;text-align:left;transition:.18s}.portal-card:hover{border-color:#b9d0fa;box-shadow:0 9px 24px rgba(35,86,157,.08);transform:translateY(-2px)}.portal-icon{width:42px;height:42px;display:grid;place-items:center;flex:0 0 auto;background:#edf3ff;color:#3574e2;border-radius:12px}.portal-icon.large{width:47px;height:47px}.portal-card-text{min-width:0;flex:1}.portal-card-text strong{display:block;font-size:12px;color:#28425f}.portal-card-text small{display:block;color:#8594a7;font-size:9px;line-height:1.4;margin-top:4px}.portal-arrow{color:#8ea1b7}.public-footer{padding:19px max(28px,calc((100vw - 1194px)/2));display:flex;align-items:center;justify-content:space-between;gap:18px;background:#fbfcfe;border-top:1px solid #edf1f7}.public-footer>.brand-lockup{transform:scale(.9);transform-origin:left center}.public-footer>span{color:#92a0b1;font-size:10px}.mode-switch{display:flex;align-items:center;gap:4px;background:#eff3f8;padding:4px;border-radius:9px}.mode-switch span{font-size:9px;font-weight:700;color:#8392a4;padding:0 6px}.mode-switch button{border:0;background:transparent;padding:5px 8px;border-radius:6px;font-size:9px;font-weight:700;color:#77869a}.mode-switch button.selected{background:white;color:#2e69d1;box-shadow:0 1px 4px #dce4ef}.auth-layout,.setup-layout{max-width:1080px;min-height:calc(100vh - 76px);margin:0 auto;padding:65px 28px;display:grid;grid-template-columns:1fr 460px;gap:85px;align-items:center}.auth-side-copy h1,.setup-intro h1{font-size:48px}.auth-feature-list{display:grid;gap:15px;margin-top:32px;color:#58708c;font-size:12px;font-weight:600}.auth-feature-list span{display:flex;align-items:center;gap:10px}.auth-feature-list svg{color:#3b78e7}.auth-card{background:#fff;border:1px solid #e8edf4;border-radius:17px;padding:27px;box-shadow:0 18px 45px rgba(32,61,96,.08)}.auth-card-heading{text-align:center;margin-bottom:23px}.auth-card-heading .portal-icon{margin:0 auto 13px}.auth-card-heading h2{font:800 21px Manrope;color:#183653;margin:0 0 7px}.auth-card-heading p{font-size:11px;color:#8998aa;margin:0}.form-stack{display:grid;gap:15px}.field-label{display:grid;gap:7px;font-size:11px;color:#4d6178;font-weight:700}.input-control{width:100%;min-width:0;border:1px solid #dfe6ef;border-radius:9px;background:#fff;padding:11px 12px;color:#20364e;font-size:12px;outline:none;transition:.15s}.input-control:focus{border-color:#76a1f2;box-shadow:0 0 0 3px #edf3ff}.input-control::placeholder{color:#adb8c6}.input-icon-wrap{position:relative}.input-icon-wrap>svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#91a1b5}.input-control.with-icon{padding-left:38px}.inline-error{background:#fff1f0;border:1px solid #ffd6d2;color:#b53d36;padding:10px 12px;border-radius:8px;font-size:11px;line-height:1.5}.auth-card-foot{display:flex;justify-content:space-between;align-items:center;gap:9px;border-top:1px solid #edf1f6;margin-top:19px;padding-top:15px;color:#8291a4;font-size:9px}.auth-card-foot span{display:flex;align-items:center;gap:5px}.auth-card-foot button{border:0;background:none;color:#3674e7;font-size:10px;font-weight:700}.setup-layout{grid-template-columns:.85fr 1.15fr;gap:60px}.setup-card{padding:25px}.setup-security{display:flex;gap:12px;margin-top:30px;padding:15px;background:#edf5ff;border:1px solid #e1ecff;border-radius:11px;color:#3670cf}.setup-security strong,.setup-security small{display:block}.setup-security strong{font-size:11px;color:#284e87}.setup-security small{font-size:10px;line-height:1.6;color:#7187a5;margin-top:4px}.form-two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field-help{font-size:9px;font-weight:400;line-height:1.5;color:#8b99aa}.loading-screen{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:14px;background:#f8faff}.loading-brand{font:800 23px Manrope;color:#183653}.loading-brand span{color:#3675e8}.loading-spinner,.spin{animation:spin 1s linear infinite}.loading-spinner{width:25px;height:25px;border:3px solid #dce8fb;border-top-color:#3475e8;border-radius:50%}.loading-screen p{font-size:11px;color:#8797aa}@keyframes spin{to{transform:rotate(360deg)}}.toast{position:fixed;z-index:1000;bottom:23px;right:24px;display:flex;align-items:center;gap:9px;max-width:min(460px,calc(100vw - 30px));padding:13px 15px;border-radius:10px;box-shadow:0 12px 36px rgba(23,48,80,.2);font-size:11px;font-weight:600}.toast button{border:0;background:none;color:inherit;margin-left:8px;display:grid;place-items:center}.toast-error{background:#fff2f0;border:1px solid #ffd8d1;color:#ad3d34}.toast-success{background:#effbf5;border:1px solid #cceedd;color:#187c59}.build-corner{position:fixed;z-index:3;bottom:6px;left:10px;font-size:7px;letter-spacing:1px;color:#b2bfcd;font-weight:800;pointer-events:none}
/* Authenticated application */
.app-shell{min-height:100vh;background:#f4f7fb}.sidebar{position:fixed;z-index:20;left:0;top:0;bottom:0;width:250px;background:#102d4d;color:#d7e3f1;padding:22px 15px 16px;display:flex;flex-direction:column}.sidebar-brand{padding:0 6px 23px;border-bottom:1px solid rgba(255,255,255,.1)}.sidebar-brand .brand-mark{background:linear-gradient(145deg,#548cf3,#2b5bb0);box-shadow:none}.sidebar-brand strong{color:white;font-size:15px}.sidebar-brand small{color:#8299b4}.institution-switch{margin:18px 0 25px;padding:10px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.09);border-radius:10px;display:flex;align-items:center;gap:9px}.institution-avatar{width:32px;height:32px;border-radius:9px;background:#29496b;color:#a8c6f2;display:grid;place-items:center}.institution-switch>div:nth-child(2){flex:1;min-width:0}.institution-switch strong,.institution-switch small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.institution-switch strong{font-size:10px;color:white}.institution-switch small{font-size:8px;color:#90a6c0;margin-top:3px}.institution-switch>svg{color:#8fa6c1}.sidebar-label{font-size:8px;font-weight:800;letter-spacing:1.5px;color:#7890ac;padding:0 10px 9px}.sidebar-nav{display:grid;gap:4px;overflow:auto}.sidebar-nav button,.sidebar-nav-button{position:relative;width:100%;border:0;background:transparent;color:#a9bdd3;display:flex;align-items:center;gap:12px;text-align:left;padding:10px 11px;border-radius:8px;font-size:11px;font-weight:600}.sidebar-nav button:hover,.sidebar-nav-button:hover{background:rgba(255,255,255,.07);color:white}.sidebar-nav button.active{background:linear-gradient(90deg,rgba(62,125,232,.26),rgba(62,125,232,.13));color:white}.sidebar-nav button.active>svg{color:#82b1ff}.sidebar-nav button.active i{position:absolute;right:0;width:3px;height:20px;background:#6da0f5;border-radius:4px}.sidebar-bottom{margin-top:auto;border-top:1px solid rgba(255,255,255,.1);padding-top:14px}.sidebar-help{display:flex;align-items:center;gap:9px;padding:8px 5px 13px}.help-icon{width:31px;height:31px;background:rgba(255,255,255,.08);border-radius:9px;display:grid;place-items:center;color:#9ec0f7}.sidebar-help strong,.sidebar-help small{display:block}.sidebar-help strong{font-size:9px;color:white}.sidebar-help small{font-size:8px;color:#879eb8;margin-top:3px}.sidebar-nav-button{padding:9px 10px}.sidebar-scrim{display:none}.main-shell{margin-left:250px;min-height:100vh}.app-topbar{height:70px;background:white;border-bottom:1px solid #e8edf4;padding:0 30px;display:flex;align-items:center;justify-content:space-between;position:sticky;z-index:10;top:0}.breadcrumbs{display:flex;align-items:center;gap:10px;color:#91a0b2;font-size:10px}.breadcrumbs strong{color:#425b78;font-weight:700}.topbar-right{display:flex;align-items:center;gap:17px}.workspace-mode{font-size:9px;padding:7px 10px}.workspace-mode i{width:6px;height:6px;border-radius:50%;background:currentColor}.topbar-icon{color:#75889e}.profile-wrap{position:relative}.profile-button{border:0;background:transparent;display:flex;align-items:center;gap:9px;text-align:left}.user-avatar{width:33px;height:33px;border-radius:10px;background:#eaf1ff;color:#316bd1;display:grid;place-items:center;font-weight:800;font-size:12px}.profile-meta strong,.profile-meta small{display:block}.profile-meta strong{font-size:10px;color:#314a66}.profile-meta small{font-size:8px;color:#8b9bae;margin-top:2px}.profile-button>svg{color:#91a0b2}.profile-menu{position:absolute;right:0;top:47px;width:220px;background:white;border:1px solid #e7edf4;border-radius:10px;padding:12px;box-shadow:var(--shadow)}.profile-menu>div{padding:4px 5px 11px;border-bottom:1px solid #edf1f5}.profile-menu strong,.profile-menu small{display:block;overflow:hidden;text-overflow:ellipsis}.profile-menu strong{font-size:10px}.profile-menu small{font-size:9px;color:#8594a7;margin-top:4px}.profile-menu button{margin-top:9px;width:100%;border:0;background:#fff4f2;color:#b64b43;border-radius:7px;padding:8px;display:flex;align-items:center;gap:8px;font-size:10px;font-weight:700}.page-content{max-width:1450px;padding:30px 31px 45px;margin:0 auto}.page-title-row{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}.page-title-row h1{font:800 27px Manrope;color:#183653;letter-spacing:-.9px;margin:7px 0 5px}.page-title-row p{font-size:11px;color:#8191a4;margin:0;line-height:1.55}.date-chip{font-size:9px;color:#6b7f96;background:white;border:1px solid #e6edf5;padding:9px 12px;border-radius:8px}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.metric-card{position:relative;overflow:hidden;text-align:left;padding:17px;background:white;border:1px solid #e7edf5;border-radius:12px;box-shadow:0 3px 12px rgba(26,57,93,.025);transition:.17s}.metric-card:hover{transform:translateY(-2px);box-shadow:var(--shadow);border-color:#d6e3f7}.metric-icon{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;margin-bottom:13px}.metric-icon.blue{color:#3475e5;background:#edf3ff}.metric-icon.violet{color:#8560d7;background:#f2edff}.metric-icon.green{color:#1e9b73;background:#e9f8f2}.metric-icon.amber{color:#c58a2c;background:#fff6e6}.metric-label{display:block;font-size:10px;color:#8796a8;font-weight:600}.metric-card>strong{display:block;font:800 26px Manrope;color:#1d3a59;margin:4px 0 1px}.metric-card>small{font-size:9px;color:#9aa7b6}.metric-arrow{position:absolute;right:15px;top:17px;color:#b0bdcc}.overview-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:15px;margin-top:16px}.table-card{background:white;border:1px solid #e7edf4;border-radius:12px;box-shadow:0 3px 12px rgba(26,57,93,.025)}.overview-panel{padding:19px}.panel-heading{display:flex;justify-content:space-between;align-items:start}.panel-heading h3,.module-card-heading h3,.account-info-card h3{font:800 14px Manrope;color:#294561;margin:0}.panel-heading p,.module-card-heading p{font-size:9px;color:#91a0b2;margin:5px 0 0}.panel-tag{font-size:8px;font