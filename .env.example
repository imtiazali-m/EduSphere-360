# Copy this file to .env.local and enter values from your own Supabase project.
# These browser variables are PUBLIC keys only. Never put a Supabase secret/service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_DEFAULT_MODE=local
